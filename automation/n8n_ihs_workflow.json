{
    "name": "IHS Outlook to MySQL Automation",
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "sync-outlook-report",
                "options": {}
            },
            "id": "e4a8b2d1-0a3b-4c5d-8e9f-a1b2c3d4e5f6",
            "name": "Webhook",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1,
            "position": [
                400,
                300
            ],
            "webhookId": "ihs-sync-trigger"
        },
        {
            "parameters": {
                "resource": "message",
                "operation": "getAll",
                "limit": 1,
                "filters": {
                    "subject": "One Page Report"
                },
                "options": {
                    "includeAttachments": true
                }
            },
            "id": "f5b9c3e2-1b4c-5d6e-9f0a-b2c3d4e5f6g7",
            "name": "Microsoft Outlook",
            "type": "n8n-nodes-base.microsoftOutlook",
            "typeVersion": 2,
            "position": [
                600,
                300
            ],
            "credentials": {
                "microsoftOutlookOAuth2Api": {
                    "id": "outlook-credential-id",
                    "name": "Minha Conta Outlook"
                }
            }
        },
        {
            "parameters": {
                "operation": "toRead",
                "options": {
                    "readAllSheets": false
                }
            },
            "id": "g6c0d4f3-2c5d-6e7f-0a1b-c3d4e5f6g7h8",
            "name": "Extrair Dados Excel",
            "type": "n8n-nodes-base.spreadsheetFile",
            "typeVersion": 1,
            "position": [
                800,
                300
            ]
        },
        {
            "parameters": {
                "operation": "insert",
                "table": "equipamentos_ihs",
                "columns": "unidade, modelo, numero_serie, tecnico_responsavel",
                "options": {}
            },
            "id": "h7d1e5g4-3d6e-7f8g-1b2c-d4e5f6g7h8i9",
            "name": "Inserir no MySQL",
            "type": "n8n-nodes-base.mySql",
            "typeVersion": 1,
            "position": [
                1000,
                300
            ],
            "credentials": {
                "mySql": {
                    "id": "mysql-credential-id",
                    "name": "Banco de Dados Local"
                }
            }
        }
    ],
    "connections": {
        "Webhook": {
            "main": [
                [
                    {
                        "node": "Microsoft Outlook",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Microsoft Outlook": {
            "main": [
                [
                    {
                        "node": "Extrair Dados Excel",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Extrair Dados Excel": {
            "main": [
                [
                    {
                        "node": "Inserir no MySQL",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}